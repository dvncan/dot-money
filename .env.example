# --- DefraDB ---
DEFRA_URL=http://127.0.0.1:9181
# Path to a defradb binary; defaults to `defradb` on PATH
DEFRA_BIN=$HOME/Developer/defras/v1.0.0/defradb

# --- API ---
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too

# --- Plaid (sandbox) — leave blank to run without bank linking ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
